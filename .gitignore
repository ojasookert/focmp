# Publish only the buildable mod and its build/installation instructions.
/*
!/.gitignore
!/README.md
!/rust-toolchain.toml
!/focmp.ini
!/focmp/
!/loader/
!/installer/
!/LICENSE
!/scripts/
!/.github/
!/docs/

/focmp/*
!/focmp/Cargo.toml
!/focmp/Cargo.lock
!/focmp/BUILD_VERSION
!/focmp/build.rs
!/focmp/src/
/scripts/*
!/scripts/build.sh
!/scripts/package_release.py
!/scripts/package_installer.py
!/scripts/check_installer.py
!/scripts/make_art.py
/docs/*
!/docs/header.webp
!/docs/installer.webp

# Generated files and local secrets remain excluded everywhere.
target/
__pycache__/
*.py[cod]
*.dll
*.exe
*.zip
*.log
.env
.env.*
